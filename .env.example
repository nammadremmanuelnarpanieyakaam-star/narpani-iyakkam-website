# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Port the server runs on
PORT=3000

# Secret key required to view volunteer submissions at GET /api/volunteers
# Set this to any random string you choose.
ADMIN_KEY=change-this-to-a-random-secret

# --- Optional: email notifications for new sign-ups ---
# Leave these blank to disable email notifications.
# EMAIL_USER should be a Gmail address, EMAIL_PASS should be a
# Google "App Password" (NOT your normal Gmail password) —
# generate one at https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# Where new volunteer notifications should be sent
NOTIFY_EMAIL=nammadoctoremmanuelnarpanieyakaam@gmail.com
